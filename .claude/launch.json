{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "usual-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "uvicorn",
        "main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "port": 8000
    },
    {
      "name": "usual-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "dev"
      ],
      "autoPort": true
    },
    {
      "//": "Service workers, the manifest and install checks only behave in a production build (DESIGN.md §2). Needs `pnpm --dir frontend build` first.",
      "name": "tally-web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "start",
        "--port",
        "3100"
      ],
      "port": 3100
    }
  ]
}
