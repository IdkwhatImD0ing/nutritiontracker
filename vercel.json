{
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- frontend backend vercel.json ':(exclude)backend/tests'",
  "services": {
    "web": {
      "root": "frontend"
    },
    "api": {
      "root": "backend",
      "entrypoint": "main:app",
      "functions": {
        "main.py": {
          "maxDuration": 120,
          "excludeFiles": "{tests/**,backend/tests/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
