{
  "services": {
    "web": {
      "root": "frontend",
      "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- ':(top)frontend' ':(top)backend' ':(top)vercel.json' ':(top,exclude)backend/tests' || exit 1"
    },
    "api": {
      "root": "backend",
      "entrypoint": "main:app",
      "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- ':(top)frontend' ':(top)backend' ':(top)vercel.json' ':(top,exclude)backend/tests' || exit 1",
      "functions": {
        "main.py": {
          "maxDuration": 120,
          "excludeFiles": "{tests/**,backend/tests/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
