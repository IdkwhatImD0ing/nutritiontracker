# Tally — environment variables (names only; see docs/DESIGN.md §0.5 and docs/ONBOARDING.md)
#
# Two ways to fill this in:
#
#   The owner's machines: every value is stored in the Vercel project's
#   Development environment, so
#     vercel link
#     vercel env pull .env --environment=development --yes
#     cp .env frontend/.env.local     # Next does not read the repo-root .env
#
#   Your own instance: cp .env.example .env, fill in your own keys
#   (ONBOARDING.md §8 "Running your own instance" walks through each one),
#   then cp .env frontend/.env.local.
#
# Never commit .env. Never print a secret value — names only.
#
# Not listed below, on purpose:
#   APP_ORIGIN    — Production only (pins the Origin check on state-changing requests);
#                   unset locally so backend/auth.py's localhost allowance applies
#   STT_PROVIDER  — optional; "deepgram" (default) or "openai" picks the primary
#                   transcriber, the other one is the fallback

# Neon Postgres — the POOLED (-pooler) connection string. Auto-provisioned by the
# Vercel Marketplace integration on the owner's project; from the Neon Console on yours.
DATABASE_URL=

# Neon Managed Better Auth (enable on the branch: Console → Project → Branch → Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=          # self-generated, ≥32 chars: openssl rand -base64 32

# Owner account. This address gets the unlimited account; every other sign-up is a
# demo account (one log a day — docs/DESIGN.md §8.9). Read by backend/auth.py only —
# sign-up is open to any address — and it defaults to the original author's address, so
# set it on your own instance. Migration 002 does not read it — see docs/ONBOARDING.md §8.3.
ALLOWED_EMAIL=

# OpenAI — GPT-5.6 (decompose + photo vision: gpt-5.6-luna, agent: gpt-5.6-terra) + web search tool
OPENAI_API_KEY=

# Deepgram — speech-to-text (primary STT; OpenAI transcribe is the fallback)
DEEPGRAM_API_KEY=

# USDA FoodData Central — all food data (free key: https://fdc.nal.usda.gov/api-key-signup)
FDC_API_KEY=

# Open Food Facts — no key; OFF asks for a descriptive User-Agent with a contact.
# Read by backend/sources/off.py (the barcode miss-fallback, docs/DESIGN.md §8.2);
# unset, the adapter sends the string DESIGN.md §0.5 documents.
OFF_USER_AGENT="tally/0.1 (you@example.com)"

# Langfuse Cloud (v4 SDKs read LANGFUSE_BASE_URL)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=                # e.g. https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development   # production / preview set in Vercel env settings
