# Usual — required environment variables (see docs/DESIGN.md §0.5)
#
# You normally do NOT fill this in by hand. Every value below is stored in the
# Vercel project's Development environment, so on a new machine just run:
#
#   vercel link
#   vercel env pull .env --environment=development --yes
#   cp .env frontend/.env.local     # Next does not read the repo-root .env
#
# This file documents the canonical names for when that is not an option.
# Never commit .env. See docs/ONBOARDING.md.
#
# Not listed here, on purpose:
#   APP_ORIGIN    — Production only; unset locally so the dev Origin allowance applies
#   ALLOWED_EMAIL — optional; backend/auth.py hardcodes the same single-user default

# Neon Postgres (auto-provisioned by the Vercel Marketplace integration; DATABASE_URL is the pooled one)
DATABASE_URL=

# Neon Managed Better Auth (enable on the branch: Console → Project → Branch → Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=          # self-generated, ≥32 chars: openssl rand -base64 32

# OpenAI — GPT-5.6 (decompose: gpt-5.6-luna, agent: gpt-5.6-terra) + web search tool
OPENAI_API_KEY=

# Deepgram — speech-to-text (primary STT)
DEEPGRAM_API_KEY=

# USDA FoodData Central — all food data (free key: https://fdc.nal.usda.gov/api-key-signup)
FDC_API_KEY=

# Open Food Facts — no key; descriptive User-Agent is mandatory
OFF_USER_AGENT="usual/0.1 (billzhangsc@gmail.com)"

# Langfuse Cloud (v4 SDKs read LANGFUSE_BASE_URL)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=                # e.g. https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development   # production / preview set in Vercel env settings
